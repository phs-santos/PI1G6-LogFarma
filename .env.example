# .env do desenvolvimento (raiz do monorepo). Copie para .env: infra/scripts/setup-dev.sh
# Só o que não tem padrão fica ativo. O resto está comentado com o valor padrão:
# descomente apenas se precisar trocar.

# ---------- Obrigatórias ----------
# Banco local (o Postgres do infra/compose.yaml: usuário pi, senha pi, banco pi).
DATABASE_URL=postgres://pi:pi@localhost:5432/pi
# Assina o cookie de sessão. Qualquer texto serve no dev; na VPS, use openssl rand -hex 32.
JWT_SECRET=troque-este-segredo

# ---------- Primeiro gestor ----------
# Criado ao iniciar o backend só se ainda não existir nenhum gestor (o seed de demo já cria um).
# Depois a senha muda pelo app; estas linhas podem ser apagadas. Use um e-mail que você lê.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# ADMIN_NAME=Administrador

# ---------- E-mail (recuperar senha) por SMTP — qualquer provedor ----------
# Vazio: não envia; em desenvolvimento o link aparece no log do backend.
# Resend: SMTP_HOST=smtp.resend.com, SMTP_USER=resend, SMTP_PASS=<chave re_...>
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
# SMTP_PORT=465            # 465/2465 = SSL direto; 587/2587 = STARTTLS (aí SMTP_SECURE=false)
# SMTP_SECURE=true
# EMAIL_FROM=LogFarma <nao-responda@logfarma.codexolimpo.com.br>
# APP_URL=                 # endereço das telas nos links; vazio = CORS_ORIGIN

# ---------- Opcionais (padrão ao lado) ----------
# PORT=3333
# HOST=0.0.0.0
# CORS_ORIGIN=http://localhost:5173
# DATABASE_URL_TEST=postgres://pi:pi@localhost:5432/pi_test   # banco do pnpm test
# DEMO_PASSWORD=demo1234      # senha das contas do pnpm db:seed
# COOKIE_SECURE=false         # true só com HTTPS
# ALLOW_DEMO_SEED=false       # só produção: libera o seed (apaga tudo)

# Banco do Docker (pnpm docker:dev). Se trocar usuário/senha/banco, ajuste o DATABASE_URL.
# POSTGRES_USER=pi
# POSTGRES_PASSWORD=pi
# POSTGRES_DB=pi
# DB_PORT=5432                # porta no seu computador, se a 5432 já estiver ocupada
