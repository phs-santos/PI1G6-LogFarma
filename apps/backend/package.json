{
    "name": "@fatec-pi/backend",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
        "test": "vitest run",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
        "db:seed": "tsx --env-file-if-exists=.env src/db/seed.ts"
    },
    "dependencies": {
        "@fastify/cookie": "^11.1.5",
        "@fastify/cors": "^11.3.1",
        "@fastify/jwt": "^10.2.7",
        "@node-rs/argon2": "^2.2.2",
        "drizzle-orm": "^0.45.4",
        "fastify": "^5.12.7",
        "fastify-plugin": "^5.1.0",
        "pg": "^8.23.1"
    },
    "devDependencies": {
        "@types/node": "^26.6.5",
        "@types/pg": "^8.23.1",
        "drizzle-kit": "^0.31.11",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "vitest": "^5.1.0"
    }
}
