PORT=3333
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
# Banco local do infra/compose.yaml (docker compose -f infra/compose.yaml up -d db)
DATABASE_URL=postgres://pi:pi@localhost:5432/pi
# Banco usado pelos testes (criado automaticamente)
DATABASE_URL_TEST=postgres://pi:pi@localhost:5432/pi_test
# Segredo que assina o token de sessão. Em produção, use um valor longo e aleatório.
JWT_SECRET=troque-este-segredo
# true só quando o site estiver em HTTPS
COOKIE_SECURE=false
# Permite rodar o seed da demonstração (apaga e recarrega os dados). Nunca deixe true com dados reais.
ALLOW_DEMO_SEED=false
# Senha das contas de demonstração criadas pelo seed
DEMO_PASSWORD=demo1234
# Validade padrão das receitas, em dias (confira com a norma do município)
PRESCRIPTION_DAYS_SIMPLE_CONTINUOUS=180
PRESCRIPTION_DAYS_SIMPLE=30
PRESCRIPTION_DAYS_ANTIMICROBIAL=10
PRESCRIPTION_DAYS_SPECIAL_CONTROL=30
