{
    "permissions": {
        "allow": [
            "Bash(pnpm install)",
            "Bash(pnpm typecheck)",
            "Bash(pnpm build)",
            "Bash(pnpm dev)",
            "Bash(pnpm format:check)",
            "Bash(pnpm format)",
            "Bash(pnpm dev:backend)",
            "Bash(pnpm dev:frontend)",
            "Bash(pnpm storybook)",
            "Bash(pnpm --filter:*)",
