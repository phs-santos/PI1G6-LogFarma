{
    "name": "pi1g6-logfarma",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.33.2",
    "scripts": {
        "dev": "pnpm --parallel --filter @fatec-pi/backend --filter @fatec-pi/frontend dev",
        "dev:backend": "pnpm --filter @fatec-pi/backend dev",
        "dev:frontend": "pnpm --filter @fatec-pi/frontend dev",
        "storybook": "pnpm --filter @fatec-pi/style-guide storybook",
        "typecheck": "pnpm -r typecheck",
        "build": "pnpm -r build",
        "docker:dev": "docker compose $([ -f .env ] && echo --env-file .env) -f infra/compose.yaml up --build",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "pnpm -r test"
    },
    "devDependencies": {
        "prettier": "^3.9.10"
    }
}
