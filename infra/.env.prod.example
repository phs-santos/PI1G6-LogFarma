# Copie para ~/grupo-pi-6/.env na VPS e preencha. Nunca faça commit deste arquivo preenchido.
POSTGRES_USER=pi
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=pi
# Endereço público do site (usado no CORS do backend)
PUBLIC_URL=http://seu-dominio-ou-ip
HTTP_PORT=80

# Prefixo das imagens no GitHub Container Registry (em minúsculas: ghcr.io/<dono>/<repo>)
IMAGE_PREFIX=ghcr.io/phs-santos/pi1g6-logfarma
