# Copie para ~/grupo-pi-6/.env na VPS e preencha. Nunca faça commit deste arquivo preenchido.

# Endereço público do site (usado no CORS do backend)
PUBLIC_URL=https://seu-dominio
# Porta do site no servidor. Com proxy HTTPS na frente (Caddy), use HTTP_HOST=127.0.0.1.
HTTP_HOST=0.0.0.0
HTTP_PORT=80

# Prefixo das imagens no GitHub Container Registry (em minúsculas: ghcr.io/<dono>/<repo>)
IMAGE_PREFIX=ghcr.io/phs-santos/pi1g6-logfarma

# Banco usado pelo backend. Com um Postgres que já existe no servidor, aponte para ele
# (o container do backend precisa estar na mesma rede Docker desse Postgres).
DATABASE_URL=postgres://logfarma:troque-esta-senha@postgres:5432/logfarma

# Só para usar o Postgres próprio deste compose. Ligue com COMPOSE_PROFILES=banco-proprio
# e use DATABASE_URL=postgres://pi:<senha>@db:5432/pi
# COMPOSE_PROFILES=banco-proprio
# POSTGRES_USER=pi
# POSTGRES_PASSWORD=troque-por-uma-senha-forte
# POSTGRES_DB=pi

# Segredo que assina a sessão de login. Gere um valor longo: openssl rand -hex 32
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
# true só quando o site estiver em HTTPS (senão o navegador descarta o cookie de login)
COOKIE_SECURE=false
# Permite recarregar os dados da demonstração (APAGA TUDO). Deixe false fora dos ensaios.
ALLOW_DEMO_SEED=false
# Senha das contas de demonstração criadas pelo seed
DEMO_PASSWORD=troque-esta-senha-de-demo
